---
extends: default

rules:
  line-length:
    max: 160
    # An SSH public key is one long line that nobody can wrap.
    ignore: |
      group_vars/
      host_vars/
  comments:
    min-spaces-from-content: 1
  truthy:
    allowed-values: ["true", "false"]
  # The four rules below keep this file compatible with ansible-lint.
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
